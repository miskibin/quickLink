<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="quickLink.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:quickLink"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- SystemBackdrop is assigned in code-behind so we can fall back from Mica to Acrylic on older Windows. -->

    <Grid x:Name="RootGrid" Background="Transparent">
        <NavigationView x:Name="NavView"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        OpenPaneLength="200"
                        SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="General" Tag="General" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="AI Provider" Tag="AI">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE99A;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Hotkey" Tag="Hotkey">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="36,28,36,28">
                <Grid MaxWidth="560" HorizontalAlignment="Left">

                    <!-- ===================== General ===================== -->
                    <StackPanel x:Name="GeneralPanel" Spacing="20">
                        <TextBlock Text="General" FontSize="24" FontWeight="SemiBold"/>

                        <CheckBox x:Name="StartWithSystemCheckBox"
                                  Content="Launch on system startup"
                                  FontSize="13"
                                  Checked="OnStartWithSystemChanged"
                                  Unchecked="OnStartWithSystemChanged"/>

                        <CheckBox x:Name="HideFooterCheckBox"
                                  Content="Hide footer (make Add/Settings/Exit searchable)"
                                  FontSize="13"
                                  Checked="OnHideFooterChanged"
                                  Unchecked="OnHideFooterChanged"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Search URL (use {query} as placeholder)"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBox x:Name="SearchUrlTextBox"
                                     PlaceholderText="https://chatgpt.com/?q={query}"
                                     FontSize="13"
                                     CornerRadius="6"
                                     Background="{ThemeResource LayerFillColorDefaultBrush}"
                                     BorderThickness="1"
                                     BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                     Padding="10,8"
                                     TextChanged="OnSearchUrlChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ===================== AI Provider ===================== -->
                    <StackPanel x:Name="AiPanel" Spacing="20" Visibility="Collapsed">
                        <TextBlock Text="AI Provider" FontSize="24" FontWeight="SemiBold"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Provider"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="AiProviderComboBox"
                                      FontSize="13"
                                      CornerRadius="6"
                                      HorizontalAlignment="Stretch"
                                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                                      BorderThickness="1"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      Padding="6,4"
                                      SelectionChanged="OnAiProviderChanged">
                                <!-- xAI / Grok -->
                                <ComboBoxItem Tag="XAI">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Viewbox Width="18" Height="18">
                                            <Path Fill="{ThemeResource TextFillColorPrimaryBrush}" Stretch="Uniform"
                                                  Data="M0.12,182.71 L234.14,516.92 L338.15,516.92 L104.13,182.71 Z M0,516.92 L104.08,516.92 L156.08,442.67 L104.04,368.34 Z M466.04,0 L361.96,0 L182.1,256.86 L234.15,331.18 Z M380.78,516.92 L466.04,516.92 L466.04,37.16 L380.78,158.92 Z"/>
                                        </Viewbox>
                                        <TextBlock Text="xAI (Grok)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <!-- OpenAI -->
                                <ComboBoxItem Tag="OpenAI">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Viewbox Width="18" Height="18">
                                            <Path Fill="#10A37F" Stretch="Uniform"
                                                  Data="m297.06 130.97c7.26-21.79 4.76-45.66-6.85-65.48-17.46-30.4-52.56-46.04-86.84-38.68-15.25-17.18-37.16-26.95-60.13-26.81-35.04-.08-66.13 22.48-76.91 55.82-22.51 4.61-41.94 18.7-53.31 38.67-17.59 30.32-13.58 68.54 9.92 94.54-7.26 21.79-4.76 45.66 6.85 65.48 17.46 30.4 52.56 46.04 86.84 38.68 15.24 17.18 37.16 26.95 60.13 26.8 35.06.09 66.16-22.49 76.94-55.86 22.51-4.61 41.94-18.7 53.31-38.67 17.57-30.32 13.55-68.51-9.94-94.51zm-120.28 168.11c-14.03.02-27.62-4.89-38.39-13.88.49-.26 1.34-.73 1.89-1.07l63.72-36.8c3.26-1.85 5.26-5.32 5.24-9.07v-89.83l26.93 15.55c.29.14.48.42.52.74v74.39c-.04 33.08-26.83 59.9-59.91 59.97zm-128.84-55.03c-7.03-12.14-9.56-26.37-7.15-40.18.47.28 1.3.79 1.89 1.13l63.72 36.8c3.23 1.89 7.23 1.89 10.47 0l77.79-44.92v31.1c.02.32-.13.63-.38.83l-64.41 37.19c-28.69 16.52-65.33 6.7-81.92-21.95zm-16.77-139.09c7-12.16 18.05-21.46 31.21-26.29 0 .55-.03 1.52-.03 2.2v73.61c-.02 3.74 1.98 7.21 5.23 9.06l77.79 44.91-26.93 15.55c-.27.18-.61.21-.91.08l-64.42-37.22c-28.63-16.58-38.45-53.21-21.95-81.89zm221.26 51.49-77.79-44.92 26.93-15.54c.27-.18.61-.21.91-.08l64.42 37.19c28.68 16.57 38.51 53.26 21.94 81.94-7.01 12.14-18.05 21.44-31.2 26.28v-75.81c.03-3.74-1.96-7.2-5.2-9.06zm26.8-40.34c-.47-.29-1.3-.79-1.89-1.13l-63.72-36.8c-3.23-1.89-7.23-1.89-10.47 0l-77.79 44.92v-31.1c-.02-.32.13-.63.38-.83l64.41-37.16c28.69-16.55 65.37-6.7 81.91 22 6.99 12.12 9.52 26.31 7.15 40.1zm-168.51 55.43-26.94-15.55c-.29-.14-.48-.42-.52-.74v-74.39c.02-33.12 26.89-59.96 60.01-59.94 14.01 0 27.57 4.92 38.34 13.88-.49.26-1.33.73-1.89 1.07l-63.72 36.8c-3.26 1.85-5.26 5.31-5.24 9.06l-.04 89.79zm14.63-31.54 34.65-20.01 34.65 20v40.01l-34.65 20-34.65-20z"/>
                                        </Viewbox>
                                        <TextBlock Text="OpenAI" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <!-- Claude -->
                                <ComboBoxItem Tag="Claude">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Viewbox Width="18" Height="18">
                                            <Path Fill="#D97757" Stretch="Uniform"
                                                  Data="M17.3041 3.541h-3.6718l6.696 16.918H24Zm-10.6082 0L0 20.459h3.7442l1.3693-3.5527h7.0052l1.3693 3.5528h3.7442L10.5363 3.5409Zm-.3712 10.2232 2.2914-5.9456 2.2914 5.9456Z"/>
                                        </Viewbox>
                                        <TextBlock Text="Claude" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <!-- Custom (OpenAI-compatible) -->
                                <ComboBoxItem Tag="Custom">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE968;" FontSize="16"
                                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Custom (OpenAI-compatible)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <!-- API Key -->
                        <StackPanel x:Name="ApiKeyPanel" Spacing="6">
                            <TextBlock x:Name="ApiKeyLabel"
                                       Text="API Key"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="ApiKeyBox"
                                             Grid.Column="0"
                                             PasswordRevealMode="Hidden"
                                             PlaceholderText="Enter your API key..."
                                             FontSize="13"
                                             CornerRadius="6"
                                             Background="{ThemeResource LayerFillColorDefaultBrush}"
                                             BorderThickness="1"
                                             BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                             Padding="10,8"
                                             PasswordChanged="OnApiKeyChanged"/>
                                <Button x:Name="RevealApiKeyButton"
                                        Grid.Column="1"
                                        Width="36"
                                        Height="36"
                                        Margin="8,0,0,0"
                                        Padding="0"
                                        CornerRadius="6"
                                        Click="OnToggleRevealApiKey"
                                        ToolTipService.ToolTip="Show / hide API key">
                                    <FontIcon x:Name="RevealApiKeyIcon" Glyph="&#xE7B3;" FontSize="16"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Model -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Model"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBox x:Name="AiModelTextBox"
                                     FontSize="13"
                                     CornerRadius="6"
                                     Background="{ThemeResource LayerFillColorDefaultBrush}"
                                     BorderThickness="1"
                                     BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                     Padding="10,8"
                                     TextChanged="OnAiModelChanged"/>
                        </StackPanel>

                        <!-- Base URL (Custom only) -->
                        <StackPanel x:Name="BaseUrlPanel" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="Base URL"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBox x:Name="BaseUrlTextBox"
                                     PlaceholderText="http://localhost:11434/v1/chat/completions"
                                     FontSize="13"
                                     CornerRadius="6"
                                     Background="{ThemeResource LayerFillColorDefaultBrush}"
                                     BorderThickness="1"
                                     BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                     Padding="10,8"
                                     TextChanged="OnBaseUrlChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ===================== Hotkey ===================== -->
                    <StackPanel x:Name="HotkeyPanel" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Hotkey" FontSize="24" FontWeight="SemiBold"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Click and press a key combination"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="HotkeyTextBox"
                                         Grid.Column="0"
                                         PlaceholderText="Press keys..."
                                         FontSize="13"
                                         CornerRadius="6"
                                         Background="{ThemeResource LayerFillColorDefaultBrush}"
                                         BorderThickness="1"
                                         BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                         Padding="10,8"
                                         IsReadOnly="True"
                                         PreviewKeyDown="OnHotkeyKeyDown"
                                         LostFocus="OnHotkeyTextBoxLostFocus"
                                         Margin="0,0,8,0"/>

                                <Button x:Name="ApplyHotkeyButton"
                                        Grid.Column="1"
                                        Content="Apply"
                                        Click="OnApplyHotkey"
                                        CornerRadius="6"
                                        Padding="16,8"
                                        FontSize="12"
                                        IsEnabled="False"
                                        Margin="0,0,8,0"
                                        Style="{ThemeResource AccentButtonStyle}"/>

                                <Button Grid.Column="2"
                                        Content="Reset"
                                        Click="OnResetHotkey"
                                        CornerRadius="6"
                                        Padding="16,8"
                                        FontSize="12"/>
                            </Grid>

                            <TextBlock x:Name="HotkeyStatusText"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="Must include modifier (Ctrl, Shift, or Alt) + key"/>
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
